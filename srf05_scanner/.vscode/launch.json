{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "Debug STM32 (ST-Link GDB Server)",
            "type": "cppdbg",
            "request": "launch",
            "program": "${workspaceFolder}/build/Debug/${workspaceFolderBasename}.elf",
            "cwd": "${workspaceFolder}",
            "MIMode": "gdb",
            "miDebuggerPath": "C:/Users/long5/AppData/Local/stm32cube/bundles/gnu-gdb-for-stm32/14.3.1+st.2/bin/arm-none-eabi-gdb.exe",
            "miDebuggerServerAddress": "localhost:61234",
            "debugServerPath": "C:/Users/long5/AppData/Local/stm32cube/bundles/stlink-gdbserver/7.14.0+st.2/bin/ST-LINK_gdbserver.exe",
            "debugServerArgs": "-p 61234 -cp C:/Users/long5/AppData/Local/stm32cube/bundles/programmer/2.23.0/bin -d -s -k",
            "serverStarted": "Waiting for connection|Listen Port Number",
            "svdPath": "C:/Users/long5/AppData/Local/Arm/Packs/Keil/STM32F1xx_DFP/2.4.1/SVD/STM32F103xx.svd",
            "preLaunchTask": "Build (CMake)",
            "setupCommands": [
                {
                    "description": "Enable pretty-printing for gdb",
                    "text": "-enable-pretty-printing",
                    "ignoreFailures": true
                },
                {
                    "description": "Load symbols and flash",
                    "text": "load",
                    "ignoreFailures": false
                },
                {
                    "description": "Reset target",
                    "text": "monitor reset",
                    "ignoreFailures": false
                },
                {
                    "description": "Breakpoint at main",
                    "text": "tbreak main",
                    "ignoreFailures": false
                }
            ]
        },
        {
            "name": "Debug STM32 (Arm CMSIS / CDT GDB)",
            "type": "gdb",
            "request": "launch",
            "program": "${workspaceFolder}/build/Debug/${workspaceFolderBasename}.elf",
            "cwd": "${workspaceFolder}",
            "gdb": "C:/Users/long5/AppData/Local/stm32cube/bundles/gnu-gdb-for-stm32/14.3.1+st.2/bin/arm-none-eabi-gdb.exe",
            "svdPath": "C:/Users/long5/AppData/Local/Arm/Packs/Keil/STM32F1xx_DFP/2.4.1/SVD/STM32F103xx.svd",
            "preLaunchTask": "Build (CMake)",
            "initCommands": [
                "target extended-remote localhost:61234",
                "load",
                "monitor reset",
                "tbreak main"
            ],
            "run": "preserve"
        }
    ]
}

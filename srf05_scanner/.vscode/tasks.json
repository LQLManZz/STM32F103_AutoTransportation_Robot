{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "Release ST-Link",
            "type": "shell",
            "command": "powershell -NoProfile -Command \"Get-Process ST-LINK_gdbserver,arm-none-eabi-gdb -ErrorAction SilentlyContinue | Stop-Process -Force; exit 0\"",
            "problemMatcher": [],
            "presentation": {
                "reveal": "silent"
            }
        },
        {
            "label": "Build (CMake)",
            "type": "shell",
            "command": "cmake --build --preset Debug",
            "options": {
                "env": {
                    "PATH": "C:/Users/long5/AppData/Local/stm32cube/bundles/gnu-tools-for-stm32/14.3.1+st.2/bin;C:/Users/long5/AppData/Local/stm32cube/bundles/programmer/2.23.0/bin;${env:PATH}"
                }
            },
            "problemMatcher": "$gcc",
            "group": {
                "kind": "build",
                "isDefault": false
            }
        },
        {
            "label": "Flash STM32 (Upload)",
            "type": "shell",
            "command": "C:/Users/long5/AppData/Local/stm32cube/bundles/programmer/2.23.0/bin/STM32_Programmer_CLI.exe",
            "args": [
                "-c",
                "port=SWD",
                "-w",
                "${workspaceFolder}/build/Debug/${workspaceFolderBasename}.elf",
                "-v",
                "-rst"
            ],
            "problemMatcher": [],
            "dependsOrder": "sequence",
            "dependsOn": [
                "Release ST-Link",
                "Build (CMake)"
            ],
            "group": {
                "kind": "build",
                "isDefault": true
            }
        }
    ]
}
